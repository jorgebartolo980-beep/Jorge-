# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================
# PETCARE 360 — PAGAMENTOS & NOTIFICAÇÕES ADMINISTRATIVAS
# ============================================================

# ADMIN_NOTIFICATION_EMAIL: Endereço de email do administrador para receber alertas de pagamentos
ADMIN_NOTIFICATION_EMAIL="jorgebartolo980@gmail.com"

# PAYMENT_WEBHOOK_SECRET: Segredo criptográfico para validar assinaturas HMAC de Webhooks
PAYMENT_WEBHOOK_SECRET="whsec_petcare360_secure_k9_2026"

# STRIPE / GATEWAY DE PAGAMENTOS
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# SERVIÇO DE ENVIO DE EMAIL (Configura Resend OU SMTP)
# Opção 1: Resend API (Recomendado)
RESEND_API_KEY=""

# Opção 2: Servidor SMTP (Gmail com App Password, Sendgrid, Mailgun, Brevo, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PetCare 360 <notificacoes@petcare360.pt>"
